<Window x:Class="lab05.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:lab05.ViewModels"
        Title="Sistema Empresarial - Lab05" Height="600" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:DashboardViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel Lateral (Sidebar) -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="MENÚ PRINCIPAL" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Button Content="📦 Productos" Command="{Binding MostrarProductosCommand}" Height="40" Margin="10,5" Background="#34495E" Foreground="White" FontSize="14"/>
                <Button Content="🏷️ Categorías" Command="{Binding MostrarCategoriasCommand}" Height="40" Margin="10,5" Background="#34495E" Foreground="White" FontSize="14"/>
                <Button Content="🏢 Proveedores" Command="{Binding MostrarProveedoresCommand}" Height="40" Margin="10,5" Background="#34495E" Foreground="White" FontSize="14"/>
                <Button Content="🛒 Pedidos" Command="{Binding MostrarPedidosCommand}" Height="40" Margin="10,5" Background="#34495E" Foreground="White" FontSize="14"/>
                <Button Content="📊 Reportes" Command="{Binding MostrarReportesCommand}" Height="40" Margin="10,5" Background="#34495E" Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Área de Contenido Dinámico -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="10" />
    </Grid>
</Window>