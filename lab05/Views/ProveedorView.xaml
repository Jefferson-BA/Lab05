<UserControl x:Class="lab05.Views.ProveedorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros de Búsqueda -->
        <GroupBox Header="Búsqueda de Proveedores" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="Nombre Contacto:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding FiltroContacto}" Width="150" Margin="5"/>
                <Label Content="Ciudad:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding FiltroCiudad}" Width="120" Margin="5"/>
                <Button Content="Buscar" Command="{Binding BuscarCommand}" Width="80" Margin="10,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Formulario CRUD -->
        <GroupBox Header="Datos del Proveedor" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="ID:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ProveedorID}" Width="40" IsEnabled="False" Margin="5"/>
                <Label Content="Compañía:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding CompaniaNombre}" Width="150" Margin="5"/>
                <Label Content="Contacto:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding NombreContacto}" Width="120" Margin="5"/>
                <Label Content="Ciudad:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Ciudad}" Width="100" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Insertar" Command="{Binding InsertarCommand}" Width="90" Margin="5"/>
            <Button Content="Actualizar" Command="{Binding ActualizarCommand}" Width="90" Margin="5"/>
            <Button Content="Eliminar (Lógico)" Command="{Binding EliminarCommand}" Width="120" Margin="5" Background="#FFF44336" Foreground="White"/>
        </StackPanel>

        <!-- Grilla de Datos -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Proveedores}" AutoGenerateColumns="True" IsReadOnly="True" />
    </Grid>
</UserControl>