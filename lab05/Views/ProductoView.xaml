<UserControl x:Class="lab05.Views.ProductoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:lab05.ViewModels"
             Height="550" Width="950">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Formulario -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
            <StackPanel Margin="5">
                <Label Content="ID:" />
                <TextBox Text="{Binding ProductoID}" Width="50" IsEnabled="False"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Label Content="Nombre Producto:" />
                <TextBox Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Label Content="ID Prov:" />
                <TextBox Text="{Binding ProveedorID, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Label Content="ID Cat:" />
                <TextBox Text="{Binding CategoriaID, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Label Content="Cant x Unidad:" />
                <TextBox Text="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Label Content="Precio:" />
                <TextBox Text="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Label Content="Stock (Exist):" />
                <TextBox Text="{Binding UnidadesEnExistencia, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Label Content="Stock (Ped):" />
                <TextBox Text="{Binding UnidadesEnPedido, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            </StackPanel>
            <StackPanel Margin="5">
                <Label Content="Reorden:" />
                <TextBox Text="{Binding NivelDeReorden, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            </StackPanel>
            <StackPanel Margin="5" VerticalAlignment="Bottom">
                <CheckBox Content="Descontinuado" IsChecked="{Binding Descontinuado, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Width="80" Margin="5,0"/>
            <Button Content="Insertar" Command="{Binding InsertarCommand}" Width="80" Margin="5,0" Background="#FF4CAF50" Foreground="White"/>
            <Button Content="Actualizar" Command="{Binding ActualizarCommand}" Width="80" Margin="5,0" Background="#FF2196F3" Foreground="White"/>
            <Button Content="Eliminar (Lógico)" Command="{Binding EliminarCommand}" Width="110" Margin="5,0" Background="#FFF44336" Foreground="White"/>
            <Button Content="Recargar Lista" Command="{Binding CargarCommand}" Width="100" Margin="5,0"/>
        </StackPanel>

        <!-- Tabla de Datos -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Productos}" SelectedItem="{Binding ProductoSeleccionado}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#FFE0E0E0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProductoID}"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}"/>
                <DataGridTextColumn Header="Prov." Binding="{Binding ProveedorID}"/>
                <DataGridTextColumn Header="Cat." Binding="{Binding CategoriaID}"/>
                <DataGridTextColumn Header="Cantidad/U" Binding="{Binding CantidadPorUnidad}"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad}"/>
                <DataGridTextColumn Header="Existencia" Binding="{Binding UnidadesEnExistencia}"/>
                <DataGridTextColumn Header="En Pedido" Binding="{Binding UnidadesEnPedido}"/>
                <DataGridTextColumn Header="Reorden" Binding="{Binding NivelDeReorden}"/>
                <DataGridCheckBoxColumn Header="Descont." Binding="{Binding Descontinuado}"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>